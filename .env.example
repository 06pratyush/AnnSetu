# Copy to .env.local to develop against your Supabase project (npm run dev); without it the app
# runs in demo mode. Supabase → your project → Connect → Next.js shows these two lines. The
# publishable key is safe in the browser: row-level security protects every table. Never put the
# secret key (sb_secret_…) or the old service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Leave empty locally. The GitHub Pages workflow sets it to /<repo-name> automatically.
NEXT_PUBLIC_BASE_PATH=
