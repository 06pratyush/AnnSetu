# Copy to .env.local for local development (npm run dev).
# Supabase → Project Settings → API. The anon / publishable key is safe in the browser:
# row-level security protects every table. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Leave empty locally. The GitHub Pages workflow sets it to /<repo-name> automatically.
NEXT_PUBLIC_BASE_PATH=
